{
    "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
    "grammars": [
        {
            "name": "klar",
            "camelcase": "Klar",
            "title": "Klar",
            "scope": "source.klar",
            "file-types": ["klar"],
            "injection-regex": "^klar$",
            "class-name": "TreeSitterKlar",
            "highlights": "queries/highlights.scm",
            "locals": "queries/locals.scm"
        }
    ],
    "metadata": {
        "version": "0.1.0",
        "license": "Apache-2.0",
        "description": "The progressive programming language",
        "authors": [{ "name": "ProCode Software" }],
        "links": { "repository": "https://github.com/ProCode-Software/klar" }
    },
    "bindings": {
        "c": true,
        "go": false,
        "java": false,
        "node": true,
        "python": false,
        "rust": true,
        "swift": false,
        "zig": false
    }
}
